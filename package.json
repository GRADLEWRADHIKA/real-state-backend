{
  "name": "estateflow-backend",
  "version": "2.0.0",
  "description": "EstateFlow CRM API (Express 5 + SQLite) used by the EstateFlow dashboard and app",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts --demo",
    "start": "tsx src/index.ts",
    "start:demo": "tsx src/index.ts --demo",
    "seed:demo": "tsx src/db/seed-cli.ts --demo --reset",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:api": "tsx scripts/docs-api.ts"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@estateflow/shared": "file:./shared",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "multer": "^2.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
