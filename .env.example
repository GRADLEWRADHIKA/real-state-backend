# ─── EstateFlow CRM API ─────────────────────────────────────────────
# Mode is chosen by the start script:
#   npm start            → production: clean database, no demo data (refuses a demo database)
#   npm run dev          → demo: separate demo database with sample data and demo logins
# No third-party services are used: nothing here is an API key for an outside provider.

# Set to "demo" for a hosted demo service (same as passing --demo). Leave unset in production.
# APP_MODE=demo

PORT=7341
TZ=Asia/Kolkata

# REQUIRED in production. A long random string (e.g. `openssl rand -hex 48`), at least 32 characters.
JWT_SECRET=
# Access tokens are short-lived and refreshed automatically by the dashboard and app.
ACCESS_TOKEN_MINUTES=20
# "Keep me signed in" sessions last this many days (sliding). Other sessions last Settings → Security → Session hours.
REFRESH_REMEMBER_DAYS=30
# Oldest app version allowed to connect; older installs are asked to update.
MIN_APP_VERSION=2.0.0

# Database file (SQLite). Demo mode always uses its own file.
DATABASE_FILE=data/estateflow.db
DEMO_DATABASE_FILE=data/estateflow-demo.db
# Uploaded documents (demo mode uses "<UPLOAD_DIR>-demo").
UPLOAD_DIR=uploads/app
UPLOAD_MAX_MB=10

# Browser origins allowed to call the API in production (comma separated, wildcards allowed for
# deploy previews such as https://*--starwiz-crm.netlify.app). The Capacitor app origins
# (https://localhost, capacitor://localhost) and local dev ports are always allowed. The public
# website is served by the dashboard and the app, so a website domain pointed at the dashboard
# build (e.g. https://www.starwizrealty.com) belongs in this list too.
CORS_ORIGINS=https://crm_f.thegradlew.info,https://starwiz-crm.netlify.app

# Website forms: submissions per minute per IP, listing reads per minute per IP, and the minimum
# time (ms) a visitor must spend on a form before it is accepted.
RATE_LIMIT_PUBLIC_FORMS=10
RATE_LIMIT_PUBLIC_READ=300
FORM_MIN_FILL_MS=3000

# Requests per minute per IP: whole API, sign-in/refresh/reset endpoints, website lead form.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API=600
RATE_LIMIT_AUTH=20
RATE_LIMIT_PUBLIC_LEADS=30

# Reminder scheduler tick (follow-ups, site visits, installment dues). 0 turns it off.
SCHEDULER_INTERVAL_MS=300000

# debug | info | warn | error | silent — JSON lines on stdout/stderr.
LOG_LEVEL=info

# Optional: serve a built dashboard from this server (single-origin install).
DASHBOARD_DIST=../estateflow-dashboard/dist

# First administrator — created only when the production database has no users.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Company name shown until it is changed under Settings → Company profile.
COMPANY_NAME=
